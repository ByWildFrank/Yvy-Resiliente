# ============================================================
# YVY RESILIENTE — Variables de entorno
# Copiá este archivo a `.env` y completá los valores.
# Nunca versiones `.env` con credenciales reales.
# ============================================================

# --- Firebase (requerido para VITE_DATA_MODE=firebase) ---
VITE_FIREBASE_API_KEY=tu_api_key
VITE_FIREBASE_AUTH_DOMAIN=tu_proyecto.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=tu_proyecto_id
VITE_FIREBASE_STORAGE_BUCKET=tu_proyecto.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=tu_messaging_sender_id
VITE_FIREBASE_APP_ID=tu_app_id

# --- Modo de datos ---
# demo     → almacén local con fixtures etiquetados (desarrollo/demostación, sin credenciales)
# firebase → Firebase Auth + Firestore reales (requiere las variables de arriba)
# Si no se define, la app usa "demo" cuando falten las variables de Firebase.
VITE_DATA_MODE=demo
